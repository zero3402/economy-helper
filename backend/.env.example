# backend/.env 로 복사해 값을 채운다. .env는 gitignore돼 있고 이 파일만 커밋된다.
#
# 실행:
#   cd backend && set -a; . ./.env; set +a; ./gradlew bootRun
#
# Phase 3(k8s)에서는 이 세 개를 Secret으로 주입한다. 코드·저장소에는 넣지 않는다.

# BotFather에서 /newbot 으로 받은 토큰. 유출되면 누구나 이 봇으로 구독자에게 발송할 수 있다.
TELEGRAM_BOT_TOKEN=

# 정기 발송을 받을 채팅방 ID. 개인 채팅은 양수, 그룹은 음수다.
# 이 채팅방에서 온 명령만 처리한다 — 다른 곳에서 오면 무시한다.
# 포럼(토픽) 슈퍼그룹이면 -100으로 시작한다. 일반 그룹이 슈퍼그룹으로 승격되면 번호가 바뀌므로
# 토픽을 켠 뒤에는 반드시 다시 확인해야 한다.
TELEGRAM_CHAT_ID=

# 포럼 토픽을 쓸 때만 채운다. 비우면 토픽을 지정하지 않는다(General 토픽 / 모든 토픽 허용).
#
# 확인 방법: 해당 토픽의 아무 메시지 → 우클릭(모바일은 길게) → Copy Message Link
#   https://t.me/c/2334455667/12/34
#                 └─ 채팅 ─┘ └토픽┘ └메시지┘
#   → TELEGRAM_CHAT_ID = -1002334455667   (앞에 -100 을 붙인다)
#   → 토픽 ID          = 12
#
# 안 되면 그 토픽에서 /help@봇이름 을 쳐 본다. 거절 로그에 채팅·토픽 번호가 그대로 찍힌다.
TELEGRAM_NOTICE_TOPIC_ID=
TELEGRAM_SEARCH_TOPIC_ID=

# 웹훅 엔드포인트는 인터넷에 열려 있어야 텔레그램이 부를 수 있다. 이 값으로 사칭을 막는다.
# 텔레그램이 X-Telegram-Bot-Api-Secret-Token 헤더로 되돌려주고, 다르면 403이다.
#   생성:   openssl rand -hex 32
#   등록:   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#             -d "url=https://<서비스>/telegram/webhook" -d "secret_token=<이 값>"
# 여기와 setWebhook에 넣는 값이 반드시 같아야 한다. 다르면 모든 명령이 조용히 죽는다.
TELEGRAM_WEBHOOK_SECRET=

# Google AI Studio(aistudio.google.com/apikey)에서 발급. 무료 티어로 충분하다.
GEMINI_API_KEY=


# 한국수출입은행 환율 API — /fx의 폴백(이중화).
# 발급: koreaexim.go.kr → Open API 인증키 발급. 하루 1,000회 제한이 있어 1시간 캐시로 지킨다.
# 이 키는 쿼리 파라미터로 전송되므로 URL이 로그에 남지 않게 주의한다.
KEXIM_API_KEY=

# 공공데이터포털 — 금융위원회 주식시세정보. /stock에 쓴다.
# 발급: data.go.kr에서 회원가입 후 해당 API '활용신청'(즉시 승인). 일 1만회.
# ⚠️ 발급 화면의 **인코딩된 키**를 그대로 넣는다. 디코딩된 키를 넣으면 403이 난다.
DATA_API_KEY=

# Financial Modeling Prep — /stock의 미국 주식·지수, 브리핑의 나스닥·S&P500·NVDA·AAPL.
# 발급: site.financialmodelingprep.com 가입(카드 불필요) → Dashboard의 API Key.
# ⚠️ 무료 티어는 하루 250회, 미국 거래소 전용이다.
#    한국 심볼(005930.KS)·환율(USDKRW)·스크리너는 402이고, /api/v3는 legacy로 죽어 /stable만 쓴다.
#    응답에 레이트리밋 헤더가 없어 FmpQuotaGuard가 Redis로 직접 센다.
FMP_API_KEY=

# AccuWeather — 날씨 1순위. 6시 알람과 /weather가 여기를 먼저 친다.
# 발급: developer.accuweather.com 가입 → My Apps에서 앱 등록 → API Key.
# ⚠️ 무료 티어는 하루 50회, 일일예보는 5일까지다.
#    좌표로 바로 못 부른다 — 지점 키를 먼저 받아야 해서 조회 한 번이 호출 두 번이다.
#    지점 키를 30일 캐시(accu-location)해 조회당 1회로 낮추는 것이 실질 방어다.
#    5일을 넘는 기간은 supports()에서 빠져 Open-Meteo가 맡는다.
#    한도를 넘기면 503이고, 그 실패로 Open-Meteo로 폴백한다 — 비워 둬도 날씨는 나간다.
# 이 키는 쿼리 파라미터로 전송되므로 URL이 로그에 남지 않게 주의한다.
ACCU_API_KEY=

# 한국투자증권(KIS) — 환율 1순위, 그리고 국내·미국 시세의 1순위가 될 키.
# 발급: apiportal.koreainvestment.com → 계좌 개설·ID 연결 → Open API 신청 → 앱키/앱시크릿.
# ⚠️ 실전과 모의의 앱키가 다르고 도메인도 다르다:
#    실전 https://openapi.koreainvestment.com:9443 / 모의 https://openapivts...:29443
#    지금 application.yml은 모의를 가리킨다. 실전으로 옮기면 키와 base-url을 함께 바꾼다.
# ⚠️ 접근토큰은 1분에 한 번만 발급되고, 발급마다 계정주에게 알림톡이 간다.
#    KisTokenStore가 Redis에 캐시하는 것이 최적화가 아니라 필수다 — 요청마다 발급하면
#    차단되고 사용자 휴대폰이 하루 종일 울린다. 유효기간은 24시간이다.
# ⚠️ 초당 한도가 있다(모의 실측 1~2건, 실전 20건). 리미터 인스턴스 kis가 그걸 지킨다.
#    넘기면 HTTP 200 본문에 rt_cd=1 "초당 거래건수를 초과하였습니다"가 온다.
# ⚠️ 모의는 실전 전용 엔드포인트가 막힌다 — 분봉 환율·inquire-index-price·search-stock-info.
#    그래서 모의에서도 도는 경로만 골라 쓴다(KisFxClient javadoc 참조).
# 비워 두면 환율은 유럽중앙은행으로, 국내·미국 시세는 기존 출처로 폴백한다 — 앱은 돈다.
KIS_API_KEY=
KIS_API_SECRET=
