# backend/.env 로 복사해 값을 채운다. .env는 gitignore돼 있고 이 파일만 커밋된다.
#
# 실행:
#   cd backend && set -a; . ./.env; set +a; ./gradlew bootRun
#
# Phase 3(k8s)에서는 이 세 개를 Secret으로 주입한다. 코드·저장소에는 넣지 않는다.

# BotFather에서 /newbot 으로 받은 토큰. 유출되면 누구나 이 봇으로 구독자에게 발송할 수 있다.
TELEGRAM_BOT_TOKEN=

# 정기 발송을 받을 채팅방 ID. 개인 채팅은 양수, 그룹은 음수다.
# 확인 방법: 봇에게 아무 메시지나 보낸 뒤
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[-0-9]*'
TELEGRAM_CHAT_ID=

# Google AI Studio(aistudio.google.com/apikey)에서 발급. 무료 티어로 충분하다.
GEMINI_API_KEY=


# 한국수출입은행 환율 API — /fx의 폴백(이중화).
# 발급: koreaexim.go.kr → Open API 인증키 발급. 하루 1,000회 제한이 있어 1시간 캐시로 지킨다.
# 이 키는 쿼리 파라미터로 전송되므로 URL이 로그에 남지 않게 주의한다.
KEXIM_API_KEY=

# 공공데이터포털 — 금융위원회 주식시세정보. /stock에 쓴다.
# 발급: data.go.kr에서 회원가입 후 해당 API '활용신청'(즉시 승인). 일 1만회.
# ⚠️ 발급 화면의 **인코딩된 키**를 그대로 넣는다. 디코딩된 키를 넣으면 403이 난다.
DATA_API_KEY=
